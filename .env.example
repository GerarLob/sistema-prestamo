# La ruta es relativa a la raíz del proyecto (donde está package.json).
# El archivo queda en prisma/dev.db
DATABASE_URL="file:./prisma/dev.db"

# Puerto 3020 por defecto (3000 suele usarse por otro proyecto, ej. NexoTech)
NEXTAUTH_URL="http://localhost:3020"
NEXTAUTH_SECRET="cambiar-por-secreto-largo-aleatorio-en-produccion"

# Nombre en el recibo de pago (opcional)
# NEXT_PUBLIC_NOMBRE_EMPRESA="Mi financiera"

