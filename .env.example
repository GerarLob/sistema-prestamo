# --- Base de datos (PostgreSQL) ---
# Local con Docker (recomendado): npm run db:up
#   Mismo valor que docker-compose.yml (puerto 5433 en el host)
# DATABASE_URL="postgresql://postgres:prestamo_dev@localhost:5433/prestamos?schema=public"
# Nube gratis: https://neon.tech  → cadena con ?sslmode=require
# Vercel: Settings → Environment Variables → Production → DATABASE_URL
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Desarrollo local (puerto 3020). En Vercel puedes omitirla: se usa automáticamente VERCEL_URL.
NEXTAUTH_URL="http://localhost:3020"

# Obligatorio en producción (Vercel). Genera: openssl rand -base64 32
NEXTAUTH_SECRET="cambiar-por-secreto-largo-aleatorio-en-produccion"

# Nombre en el recibo de pago (opcional)
# NEXT_PUBLIC_NOMBRE_EMPRESA="Mi financiera"

# Opcional: usuario/clave inicial del seed (sin ADMIN_SEED_PASSWORD ⇒ admin / admin123#).
# Si definís ADMIN_SEED_PASSWORD y el admin ya existe, el próximo prisma db seed rotará esa clave.
# ADMIN_SEED_USUARIO="admin"
# ADMIN_SEED_PASSWORD="admin123#"
